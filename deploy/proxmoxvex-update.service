# deploy/proxmoxvex-update.service — one-shot update run, triggered by
# proxmoxvex-update.timer. Paired install:
#   install -m 0644 proxmoxvex-update.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now proxmoxvex-update.timer
[Unit]
Description=ProxmoxVEx update run (scheduled)
Documentation=https://proxmoxvex.com/docs/upgrading
# update.sh needs network to fetch metadata+archive; Wants= pulls the
# network-online target in, After= orders behind it.
Wants=network-online.target
After=network-online.target
# Refuse to run if another update is already holding the flock — update.sh
# also self-locks, this just keeps the unit honest.
ConditionPathExists=/opt/vex/update.sh

[Service]
Type=oneshot
# --yes: non-interactive (no TTY under systemd); the updater still exits 0
# when already current, so daily ticks are cheap no-ops.
ExecStart=/opt/vex/update.sh --yes
# Maintenance window — update.sh refuses to apply outside it. Tune per
# site or override via /etc/systemd/system/proxmoxvex-update.service.d/.
Environment=VEX_UPDATE_WINDOW=02:00-04:00
# Optional site config (tokens, mirrors, channel) — absent file is fine.
EnvironmentFile=-/etc/proxmoxvex/update.env
# Logs land in journald (journalctl -u proxmoxvex-update) and the updater's
# own logs/update.log + structured failure record on error.
Nice=10
IOSchedulingClass=idle
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# update.sh must write the install dir, state and logs — ProtectSystem=full
# leaves /opt and /var writable paths untouched? No: full mounts /usr,/boot
# ro plus /etc ro; /opt stays writable — that is the intent.
ReadWritePaths=/opt/vex /var/lib/vex /var/log

[Install]
WantedBy=multi-user.target
