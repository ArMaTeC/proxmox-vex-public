# deploy/proxmoxvex-update.timer — scheduled update check for ProxmoxVEx.
# Install:
#   install -m 0644 proxmoxvex-update.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now proxmoxvex-update.timer
# Tune the window: systemctl edit proxmoxvex-update.timer (OnCalendar=) or set
# VEX_UPDATE_WINDOW in the service's EnvironmentFile — see docs/upgrading.md.
[Unit]
Description=ProxmoxVEx scheduled update check
Documentation=https://proxmoxvex.com/docs/upgrading

[Timer]
# 03:00 daily — inside the default 02:00-04:00 maintenance window; the
# 1h randomized delay staggers fleet check-ins so the CDN isn't hammered.
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
