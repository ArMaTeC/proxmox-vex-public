{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxmoxvex.com/schemas/version.schema.json",
  "title": "ProxmoxVEx release metadata",
  "type": "object",
  "required": [
    "version",
    "release_date",
    "changelog"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "build": {
      "type": "string"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "fix",
              "feature",
              "breaking",
              "security",
              "perf",
              "docs",
              "chore"
            ]
          },
          "component": {
            "type": "string"
          },
          "breaking": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "prev_changelog": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "min_python": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+"
    },
    "platforms": {
      "type": "array",
      "items": {"type": "string"},
      "description": "US068: allowed uname -m values; absent = x86_64+aarch64"
    },
    "platforms_glibc": {"type": "array", "items": {"type": "string"}},
    "platforms_musl": {"type": "array", "items": {"type": "string"}},
    "download_url": {
      "type": "string"
    },
    "docs_url": {
      "type": "string"
    },
    "update_archive": {
      "type": "string"
    },
    "update_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "breaking_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+"
          },
          "archive": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "cohort": {
            "type": "string",
            "enum": [
              "opt-in",
              "all"
            ]
          }
        }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "releases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "support_until": {
            "type": "string",
            "format": "date"
          },
          "min_from": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+"
          },
          "via": {
            "type": "string"
          },
          "security": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "moderate",
                  "high",
                  "critical"
                ]
              },
              "advisory": {
                "type": "string"
              }
            },
            "required": [
              "severity"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "mirrors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_python": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+"
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}